// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model NewsletterSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  customerName    String
  email           String
  phone           String
  address         String
  province        String
  district        String?
  instructions    String?
  deliveryMethod  String
  paymentMethod   String
  items           String // JSON-encoded OrderItem[]
  adjustments     String? // JSON-encoded OrderAdjustment[] — lines the shelf trimmed
  subtotal        Float
  shipping        Float
  discount        Float
  total           Float
  farmersSupported Int
  giftWrap        Boolean @default(false)
  giftNote        String?
  createdAt       DateTime @default(now())
}

// "Wake me at harvest" — shoppers who asked to be told when a resting
// harvest returns to the fields. One row per (product, email).
model HarvestAlert {
  id        String   @id @default(cuid())
  productId String // product id, e.g. p-kampot-black-pepper
  email     String
  createdAt DateTime @default(now())

  @@unique([productId, email])
  @@index([productId])
}

// "Reserve next harvest" — a real hold on a resting harvest: size, quantity
// and the email to write when the fields gather it again. Reserved at
// today's price; payment happens only when the harvest leaves the fields.
model HarvestReservation {
  id        String   @id @default(cuid())
  productId String // product id, e.g. p-kampot-black-pepper
  email     String
  sizeLabel String // e.g. "250g"
  qty       Int // units held for this shopper
  createdAt DateTime @default(now())

  @@unique([productId, email, sizeLabel])
  @@index([productId])
}

// Customer reviews persisted from the product page ("Write a Review").
// Seeded/derived reviews live in the client; these are the real submissions.
model Review {
  id        String   @id @default(cuid())
  productId String // product id, e.g. p-kampot-black-pepper
  name      String
  location  String?
  rating    Int // 1–5
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([productId, createdAt(sort: Desc)])
}
